# Base URL of the DMS API INCLUDING the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# "dev" (local only, refused in production builds) or "supabase".
NEXT_PUBLIC_AUTH_MODE=dev
# Only used when NEXT_PUBLIC_AUTH_MODE=supabase. PUBLIC/publishable key only - never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Used by `npm run api:sync` to copy the OpenAPI snapshot from a sibling backend checkout.
DMS_BACKEND_DIR=../enterprise-dms-backend
